# Copy this file to .env and fill in real SMTP credentials.
# Gmail requires an app password, not your normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-sending-account@gmail.com
SMTP_PASS=your-app-password

# The inbox receiving portfolio contact messages.
CONTACT_TO=campbell.t.stephen@gmail.com

# Usually the same as SMTP_USER unless your SMTP provider allows aliases.
CONTACT_FROM=your-sending-account@gmail.com
